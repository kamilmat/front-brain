{
  "name": "@front-brain/speech",
  "version": "0.1.0",
  "description": "Live speech recognition (Web Speech API or on-device Whisper with voice activity detection) and keyword/command spotting.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@front-brain/core": "0.1.0",
    "@front-brain/transformers": "0.1.0"
  },
  "peerDependencies": {
    "vosk-browser": ">=0.0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kamilmat/front-brain.git",
    "directory": "packages/speech"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependenciesMeta": {
    "vosk-browser": {
      "optional": true
    }
  }
}
